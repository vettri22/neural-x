# NEURAL-X Environment Configuration
# Copy this file to .env and fill in your values

# ── Flask Core ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
PORT=5000

# ── Database ────────────────────────────────────────────────
# SQLite (default — no setup needed):
# DATABASE_URL=sqlite:///instance/neural_x.db

# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/neural_x

# ── Security Intelligence APIs ──────────────────────────────
# Google Safe Browsing (free tier available):
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=AIzaSyD9HBuOUlsaP3AvzRYmYeYZnFHLKStCF78

# VirusTotal (free 4 req/min):
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=6714d0846c936e6a005f63196b28e57df5f633695cd3207e82f83ec85b139c7f

# AbuseIPDB (free tier available):
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=2fe184f7fcb751c56732917022bc73684a6bf62ac12260e1dbd0ec38c8e28143cee0a14b573b4366

# ── Screenshot Service ──────────────────────────────────────
SCREENSHOT_TIMEOUT=15
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=720

# ── Rate Limiting ───────────────────────────────────────────
RATELIMIT_DEFAULT=100 per hour

# ── Production Settings (set these in production) ───────────
# SESSION_COOKIE_SECURE=true
# WTF_CSRF_ENABLED=true
