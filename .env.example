# NEURAL-X v2 Environment Variables
# Copy to .env and fill in real values.

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development        # development | production | testing

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use default SQLite file
DATABASE_URL=

# ── External Threat Intelligence APIs (all optional) ─────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ── v2: Journal Verifier settings ────────────────────────────────────────────
# Set to false to disable live external calls (useful in air-gapped environments)
JOURNAL_DOAJ_ENABLED=true
JOURNAL_CROSSREF_ENABLED=true
JOURNAL_OPENALEX_ENABLED=true
JOURNAL_CONTENT_SCAN=true
JOURNAL_REQUEST_TIMEOUT=10

# ── v3: Website Classifier & parallel workers ─────────────────────────────────
JOURNAL_ROR_ENABLED=true
JOURNAL_PARALLEL_WORKERS=4
